# Application
ENVIRONMENT=production
DEBUG=False
APP_VERSION=1.0.0

# Database
DATABASE_URL=sqlite:///./retail_iq.db

# Security
# MUST change in production! Use `openssl rand -hex 32` to generate one.
SECRET_KEY=change-this-in-production-immediately

# File Upload
MAX_UPLOAD_SIZE_MB=100

# CORS
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# AI
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-latest

# Rate Limiting
RATE_LIMIT_UPLOAD=5/hour
RATE_LIMIT_AI=30/minute
RATE_LIMIT_GENERAL=200/minute

# Logging
LOG_LEVEL=INFO

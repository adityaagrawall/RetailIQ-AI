# ============================================================
# RetailIQ AI — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=retailiq
POSTGRES_PASSWORD=retailiq_secret_change_me
POSTGRES_DB=retailiq_db

# --- Backend ---
DATABASE_URL=postgresql://retailiq:retailiq_secret_change_me@localhost:5432/retailiq_db
SECRET_KEY=your-super-secret-key-at-least-32-chars-long
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=100

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Google Gemini AI ---
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# --- ML ---
ML_ARTIFACTS_DIR=./ml_artifacts
FORECAST_HORIZON_DAYS=30
DEFAULT_LEAD_TIME_DAYS=7
